<UserControl x:Class="GameMacro.App.SkillLibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GameMacro.App.Converters"
             Background="Transparent" Foreground="#EAF0FA"
             FontFamily="Microsoft YaHei UI" FontSize="13">
    <UserControl.Resources>
        <converters:Base64PngImageConverter x:Key="Base64PngImageConverter"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C2838"/>
            <Setter Property="Foreground" Value="#F3F7FD"/>
            <Setter Property="BorderBrush" Value="#314258"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#26364A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#48617E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#121A26" BorderBrush="#28364A" BorderThickness="1" CornerRadius="10" Padding="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="3,1,3,7">
                <TextBlock Text="技能库" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="拖拽或双击添加" Foreground="#8190A5"
                           FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name" MinWidth="120"
                          Background="#E9EDF3" Foreground="#101722"
                          Padding="7,4" Margin="2"
                          SelectionChanged="CategoryCombo_SelectionChanged"/>
                <Button Grid.Column="1" Content="＋" ToolTip="新建职业" Click="NewCategory_Click"/>
                <Button Grid.Column="2" Content="改" ToolTip="重命名职业" Click="RenameCategory_Click"/>
                <Button Grid.Column="3" Content="删" ToolTip="删除空职业" Click="DeleteCategory_Click"
                        Foreground="#FF9A9A"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="1">
                <ItemsControl x:Name="TemplatesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TemplateSlot" Width="52" Height="66"
                                    Background="#151F2D" BorderBrush="#314258"
                                    BorderThickness="1" CornerRadius="4" Margin="3" Padding="3"
                                    MouseMove="Template_MouseMove"
                                    MouseLeftButtonDown="Template_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="14"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Width="44" Height="44" Background="#090E15"
                                            BorderBrush="#3B4D65" BorderThickness="1" CornerRadius="2">
                                        <Grid>
                                            <Image Source="{Binding PreviewPng, Converter={StaticResource Base64PngImageConverter}}"
                                                   Stretch="UniformToFill"/>
                                            <Border Width="14" Height="14" CornerRadius="7"
                                                    Background="#3C8DFF" BorderBrush="#B7D2FF" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-2,-2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="✓" Foreground="White" FontSize="9" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="DeleteTemplateButton" Grid.Row="1" Content="删除"
                                            FontSize="9" Padding="1,0" Margin="0,1,0,0"
                                            Background="#392128" BorderBrush="#66343E"
                                            Foreground="#FF9B9B" Opacity="0"
                                            Click="DeleteTemplate_Click"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="TemplateSlot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeleteTemplateButton" Property="Opacity" Value="1"/>
                                    <Setter TargetName="TemplateSlot" Property="BorderBrush" Value="#54749B"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                    <Setter TargetName="TemplateSlot" Property="BorderBrush" Value="#3F78BF"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <UniformGrid Grid.Row="3" Columns="2" Margin="0,7,0,0">
                <Button Content="扫描技能来源" Background="#234E7F" BorderBrush="#3D74AF"
                        Click="BatchScan_Click" Padding="5,5"/>
                <Button Content="框选单个技能" Background="#234E7F" BorderBrush="#3D74AF"
                        Click="SingleCapture_Click" Padding="5,5"/>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
