<Window x:Class="GameMacro.App.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#44000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        KeyDown="Window_KeyDown">
    <Grid>
        <TextBlock Text="拖动框选技能图标主体，Esc 取消" Foreground="White" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                       Stroke="#FFFF3333" StrokeThickness="2" Fill="#22FF3333"/>
        </Canvas>
    </Grid>
</Window>
