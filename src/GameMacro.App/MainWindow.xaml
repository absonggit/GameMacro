<Window x:Class="GameMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GameMacro.App.Converters"
        xmlns:local="clr-namespace:GameMacro.App"
        Title="按键助手 v1.0.4" Icon="Assets/AppIcon.ico"
        Width="1420" Height="820" MinWidth="1180" MinHeight="680"
        Background="#0B1018" Foreground="#EAF0FA"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Page" Color="#0B1018"/>
        <SolidColorBrush x:Key="Panel" Color="#121A26"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#172131"/>
        <SolidColorBrush x:Key="Border" Color="#28364A"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="Muted" Color="#91A0B5"/>
        <converters:Base64PngImageConverter x:Key="Base64PngImageConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C2838"/>
            <Setter Property="Foreground" Value="#F3F7FD"/>
            <Setter Property="BorderBrush" Value="#314258"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#26364A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#48617E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value=".42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1520"/>
            <Setter Property="Foreground" Value="#F3F7FD"/>
            <Setter Property="BorderBrush" Value="#2D3C51"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E9EDF3"/>
            <Setter Property="Foreground" Value="#101722"/>
            <Setter Property="BorderBrush" Value="#314258"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F8FE"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="195"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,2,4,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,0,8,0">
                            <TextBlock Text="⌨" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="按键助手" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="v1.0.4" FontSize="11" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="方案" Style="{StaticResource SectionTitle}" Margin="0,16,0,3"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="＋ 新建方案" Click="NewProfile_Click" BorderBrush="#315C91"/>
                    <Button Content="删除方案" Click="DeleteProfile_Click"
                            Foreground="#FF8E8E" Background="#241922" BorderBrush="#55303B"/>
                </StackPanel>
                <ListBox x:Name="ProfilesList" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ProfilesList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ProfileCard" Background="#172131" BorderBrush="#26364B"
                                    BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="1,3">
                                <TextBlock Text="{Binding Name}" Foreground="#EAF0FA" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="ProfileCard" Property="Background" Value="#172E4B"/>
                                    <Setter TargetName="ProfileCard" Property="BorderBrush" Value="#4C8DFF"/>
                                    <Setter TargetName="ProfileCard" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="118"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="7" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="2.4*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProfileNameBox" Grid.Column="0"/>
                    <ComboBox x:Name="WindowCombo" Grid.Column="1" DisplayMemberPath="DisplayName"
                              SelectionChanged="WindowCombo_SelectionChanged"/>
                    <Button Grid.Column="2" Content="↻ 刷新" Click="RefreshWindows_Click"/>
                    <Button Grid.Column="3" Content="导入" Click="ImportProfile_Click"/>
                    <Button Grid.Column="4" Content="导出" Click="ExportProfile_Click"/>
                    <Button Grid.Column="5" Content="保存" Background="{StaticResource Accent}"
                            BorderBrush="#70A4FF" Click="SaveProfile_Click"/>
                </Grid>
            </Border>

            <GroupBox Grid.Row="1" Header="动态区域">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" Background="#0E1520" BorderBrush="#354A66"
                            BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="未框选" Foreground="#738198" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="RegionPreview" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="重新框选" Click="SelectRegion_Click"
                            VerticalAlignment="Center" Background="{StaticResource Accent}" Margin="7,0"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="7,0,0,0">
                        <TextBlock x:Name="RegionStatusText" Text="尚未框选动态区域"
                                   Foreground="#77A8FF" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SourceStatusText" Text="技能模板由右侧技能库统一管理"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="方案技能">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PendingStatusText" Text="尚无技能图标"
                                   Foreground="#77A8FF" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="保存全部映射" Click="SaveAllMappings_Click"
                                Padding="9,4" Margin="2,0"/>
                    </Grid>
                    <ListBox x:Name="MappingsList" Background="Transparent" BorderThickness="0"
                             AllowDrop="True" DragOver="MappingsList_DragOver" Drop="MappingsList_Drop"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="MappingSlot" Width="60" Height="78"
                                        Background="#151F2D" BorderBrush="#314258"
                                        BorderThickness="1" CornerRadius="5" Margin="3" Padding="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48"/>
                                            <RowDefinition Height="22"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="48" Height="48" Background="#0A0F16"
                                                BorderBrush="#3A4B62" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Image Source="{Binding PreviewPng, Converter={StaticResource Base64PngImageConverter}}"
                                                       Stretch="UniformToFill"/>
                                                <Border Background="#D0341F24" Padding="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissingTemplate}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="缺失" Foreground="#FFD7D7" FontSize="9"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="DeleteMappingButton" Grid.Row="0" Content="×"
                                                Click="DeletePendingMapping_Click" Width="18" Height="18"
                                                Padding="0" Margin="0" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Panel.ZIndex="5"
                                                Background="#A84242" BorderBrush="#D86666"
                                                Visibility="Collapsed"/>
                                        <Button Grid.Row="1" Click="AssignKey_Click" Padding="2,1" Margin="0,3,0,0"
                                                FontSize="12" FontWeight="SemiBold" Background="#111925">
                                            <TextBlock Text="{Binding ActionKey, FallbackValue=未设}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="DeleteMappingButton" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="MappingSlot" Property="BorderBrush" Value="#55749A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="MappingSlot" Property="BorderBrush" Value="#4C8DFF"/>
                                        <Setter TargetName="MappingSlot" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <Border Grid.Row="3" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="9" Padding="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ShowOverlayCheckBox" Content="游戏浮窗" IsChecked="True"
                                  Foreground="#EAF0FA" VerticalAlignment="Center" Margin="6,0"
                                  Checked="ShowOverlayCheckBox_Changed" Unchecked="ShowOverlayCheckBox_Changed"/>
                        <TextBlock Text="扫描" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                        <TextBox x:Name="ScanIntervalBox" Width="56" Text="20" Margin="3,0"/>
                        <TextBlock Text="ms" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/>
                        <Button x:Name="ToggleHotkeyButton" Content="启停 F5" MinWidth="84"
                                Background="#234E7F" Click="ToggleHotkeyCapture_Click" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="状态：已停止" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,0,10,0"/>
                        <Border Width="1" Height="22" Background="#33435A" Margin="2,0,10,0"/>
                        <TextBlock Text="优先打断键" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ItemsControl x:Name="InterruptKeysList" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1D2A3B" BorderBrush="#354963" BorderThickness="1"
                                            CornerRadius="4" Margin="2" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Content="×" Click="DeleteInterruptKey_Click" Width="16" Height="16"
                                                    Padding="0" Margin="4,0,0,0" Background="#71333A" BorderBrush="#9E4C55"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 添加" Click="AddInterruptKey_Click" Padding="7,3" Margin="4,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <local:SkillLibraryPanel x:Name="LibraryPanel" Grid.Column="4"/>
    </Grid>
</Window>
