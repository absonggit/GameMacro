<Window x:Class="GameMacro.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="按键助手更新"
        Width="420"
        Height="224"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B1018"
        Foreground="#E8EEF8"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False">
    <Border Margin="1" Padding="24" Background="#121A26" BorderBrush="#314158" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="发现新版本" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,10,0,0"
                       Foreground="#6FA8FF" FontSize="15"/>
            <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#AEBBCB"
                       Text="下载安装程序即可覆盖升级，已有方案与技能库会保留。"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="86" Height="34" Margin="0,0,10,0" Content="稍后"
                        Background="#263246" Foreground="#E8EEF8" BorderBrush="#3A4960"
                        Click="Later_Click"/>
                <Button Width="108" Height="34" Content="前往下载"
                        Background="#3F86F7" Foreground="White" BorderBrush="#66A1FF"
                        FontWeight="SemiBold" Click="Download_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
